# Copy to `.env` for local development. Do not commit `.env`.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Set production/preview values in the Vercel project Environment Variables UI.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Staff admin is at `/krewnox-admin/login` (aliases `/admin/login` → same).
# Included in production builds by default. Set to disable staff routes entirely:
# VITE_ADMIN_PORTAL_ENABLED=false

# Optional: custom staff URL prefix (also applies in dev).
# Example: VITE_ADMIN_BASE_PATH=/ops-7a2f9c
# VITE_ADMIN_BASE_PATH=/krewnox-admin

# Optional: comma-separated emails allowed to use the staff sign-in form (RLS still requires admin role).
# VITE_ADMIN_ALLOWED_EMAILS=you@company.com

# Server-only Stripe secret and webhook signing secret (never prefix with VITE_).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# New charges use CAD. Historical orders keep the currency stored on the order.
# Catalog prices are charged as-is in CAD; this app does not apply an exchange rate.

# Stripe publishable key for the React checkout UI (never put secret keys in VITE_ vars).
# Apple Pay / Google Pay are shown only when Stripe detects them. Live wallets need HTTPS
# plus the storefront domain registered in the Stripe Dashboard payment method domains.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional override for the payment API (defaults to /api via the Vite dev proxy).
# VITE_PAYMENTS_API_URL=http://localhost:4242/api

# Contact-form email delivery (server only — never prefix these with VITE_).
# The recipient address itself is edited in Admin → Settings and stored in site_settings.
# RESEND_API_KEY=re_your_key
# RESEND_FROM_EMAIL=Krewnox <support@krewnox.ca>
