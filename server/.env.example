# Copy to `server/.env` for local payment API development. Do not commit `server/.env`.
# Set production values in Vercel (serverless/Node) or your host's secret store.

PORT=4242
CLIENT_ORIGIN=http://localhost:5173

STRIPE_SECRET_KEY=sk_test_your_secret_key
# Signing secret for the Stripe webhook endpoint (/api/webhooks/stripe).
# Without STRIPE_WEBHOOK_SECRET the webhook route rejects every event. Receipts
# are still sent once from the server path that marks the order paid, including
# the order-status sync that retrieves a succeeded PaymentIntent.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Receipt and support email. From must be a verified Resend domain.
# RESEND_API_KEY=re_your_key
# RESEND_FROM_EMAIL=Krewnox <support@krewnox.ca>
# Admin purchase alerts use the same email service. Configure their recipient in
# Admin → Settings → New purchase alerts (blank uses the saved support email).

# Production wallets: register the live domain in Stripe Dashboard
# (Settings → Payment methods → Apple Pay / Payment method domains)
# and serve checkout over HTTPS. Localhost works only in test mode.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Required for Stripe webhook order updates AND guest checkout (orders placed without an
# account). Server only; never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
