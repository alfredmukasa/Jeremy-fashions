# Copy to `server/.env` for local payment API development. Do not commit `server/.env`.
# Set production values in Vercel (serverless/Node) or your host's secret store.

PORT=4242
CLIENT_ORIGIN=http://localhost:5173

STRIPE_SECRET_KEY=sk_test_your_secret_key
# Signing secret for the Stripe webhook endpoint (/api/webhooks/stripe).
# Without STRIPE_WEBHOOK_SECRET the webhook route rejects every event. Receipts
# are still sent once from the server path that marks the order paid, including
# the order-status sync that retrieves a succeeded PaymentIntent.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Receipt and support email. From must be a verified Resend domain.
# RESEND_API_KEY=re_your_key
# RESEND_FROM_EMAIL=Krewnox <support@krewnox.ca>
# Admin purchase alerts use the same email service. Configure their recipient in
# Admin → Settings → New purchase alerts (blank uses the saved support email).

# Production wallets: register the live domain in Stripe Dashboard
# (Settings → Payment methods → Apple Pay / Payment method domains)
# and serve checkout over HTTPS. Localhost works only in test mode.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Required for Stripe webhook order updates AND guest checkout (orders placed without an
# account). Server only; never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public catalog reads (products, categories, site content) come from Cloudflare D1
# when these are set. Server only. Never prefix them with VITE_.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_D1_DATABASE_ID=

# Signs customer and admin sessions AND the Google OAuth state cookie. Server only.
# Falls back to CLOUDFLARE_API_TOKEN.
# AUTH_SESSION_SECRET=

# Public site origin. Used for password-reset links and the default Google OAuth
# redirect URI. Defaults to https://krewnox.ca. PUBLIC_SITE_URL is accepted as an alias.
# APP_BASE_URL=https://krewnox.ca

# Google sign-in (OpenID Connect). Server only — never prefix with VITE_. When these are
# unset the Google button degrades to a clear "not configured" notice instead of failing.
# Register the redirect URI below as an Authorized redirect URI in the Google Cloud
# console (APIs & Services → Credentials → OAuth 2.0 Client ID).
#   Production redirect URI: https://krewnox.ca/api/auth/google/callback
#   Local dev redirect URI:  http://localhost:5173/api/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://krewnox.ca/api/auth/google/callback
